// Online admin — deploy with: npx wrangler deploy   (from this folder)
// Secret (set once, in the Cloudflare dashboard or `wrangler secret put`): GITHUB_TOKEN
{
  "name": "avec-anima-admin",
  "main": "src/index.js",
  "compatibility_date": "2025-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "avec-anima-uploads" }],
  "vars": {
    "GITHUB_REPO": "kylemckee358-ai/avec-anima",
    "GITHUB_BRANCH": "main",
    "SITE_URL": "https://kylemckee358-ai.github.io/avec-anima",
    // Cloudflare Access (Worker → Access tab). Blank = every request refused.
    "ACCESS_TEAM_DOMAIN": "royal-hat-f5ef.cloudflareaccess.com",
    "ACCESS_AUD": "24e95a5c75d3a48cb4f78850a8e35b0c0cc31055fe10905848efd9801f158063"
  },
  "observability": { "enabled": true }
}
